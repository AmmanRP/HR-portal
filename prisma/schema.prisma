generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Department {
  POLICE
  FIRE
  EMS
  DOT
  SWAT
  K9
  JUDGE
  CSI
  DETECTIVE
  CORONER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  INTERVIEW
  HUMAN_REVIEW
  APPROVED
  DENIED
}

enum AccountType {
  EMPLOYEE
  FTO
  HR
}

enum AccountStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

enum AccessRequestType {
  FTO
  SUPERVISOR
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum CourtRole {
  OFFICER
  SUSPECT
  ATTORNEY
  WITNESS
  JUDGE
}

enum CourtCaseStatus {
  FILED
  SCHEDULED
  IN_TRIAL
  RESOLVED
  DISMISSED
}

enum CourtOutcome {
  GUILTY
  NOT_GUILTY
  DISMISSED
}

enum CourtParticipantRole {
  OFFICER
  SUSPECT
  ATTORNEY
  WITNESS
  JUDGE
}

model Employee {
  id              String         @id @default(cuid())
  username        String         @unique
  passwordHash    String
  accountType     AccountType    @default(EMPLOYEE)
  accountStatus   AccountStatus  @default(ACTIVE)
  ftoApproved     Boolean        @default(false)
  supervisorApproved Boolean     @default(false)
  discordId       String?        @unique
  displayName     String?
  age             Int?
  robloxUsername  String?
  avatarUrl       String?
  department      Department?
  rank            String         @default("Probationary")
  badgeNumber     String?        @unique
  callsign        String?
  experienceWeeks Int            @default(0)
  isActive        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  shifts          DutyShift[]
  strikes         Strike[]
  applications   Application[]
  accessRequests  AccessRequest[]
  courtProfile    CourtProfile?
}

model CourtProfile {
  id           String       @id @default(cuid())
  employeeId   String       @unique
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role         CourtRole
  characterName String
  fictionalSsn String       @unique
  birthDate    DateTime
  address      String
  height       String
  createdAt    DateTime     @default(now())
  filedCases   CourtCase[]  @relation("FiledCases")
  defendantIn  CourtCase[]  @relation("DefendantCases")
  participations CourtParticipant[]
  evidence     CourtEvidence[]
  events       CourtEvent[]

  @@index([characterName])
}

model CourtCase {
  id               String           @id @default(cuid())
  caseNumber       String           @unique
  filedById        String
  filedBy          CourtProfile     @relation("FiledCases", fields: [filedById], references: [id])
  defendantId      String?
  defendant        CourtProfile?    @relation("DefendantCases", fields: [defendantId], references: [id])
  defendantName    String
  stateCode        String
  charge           String
  classification   String
  summary          String
  status           CourtCaseStatus  @default(FILED)
  scheduledAt      DateTime?
  plea             String?
  outcome          CourtOutcome?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  participants     CourtParticipant[]
  evidence         CourtEvidence[]
  events           CourtEvent[]

  @@index([defendantName, status])
  @@index([status, scheduledAt])
  @@index([filedById, createdAt])
}

model CourtParticipant {
  id        String                @id @default(cuid())
  caseId    String
  case      CourtCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  profileId String
  profile   CourtProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role      CourtParticipantRole
  joinedAt  DateTime              @default(now())

  @@unique([caseId, profileId])
  @@index([profileId, joinedAt])
}

model CourtEvidence {
  id          String       @id @default(cuid())
  caseId      String
  case        CourtCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy CourtProfile @relation(fields: [submittedById], references: [id])
  label       String
  description String
  createdAt   DateTime     @default(now())

  @@index([caseId, createdAt])
}

model CourtEvent {
  id        String       @id @default(cuid())
  caseId    String
  case      CourtCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String
  actor     CourtProfile @relation(fields: [actorId], references: [id])
  action    String
  details   String
  createdAt DateTime     @default(now())

  @@index([caseId, createdAt])
}

model AccessRequest {
  id           String             @id @default(cuid())
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id])
  requestType  AccessRequestType
  status       AccessRequestStatus @default(PENDING)
  requestNote  String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([employeeId, status])
  @@index([status, createdAt])
}

model Application {
  id            String            @id @default(cuid())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id])
  department    Department
  requestedRank String?
  status        ApplicationStatus @default(DRAFT)
  answers       String            @default("[]")
  reviewNote    String?
  reviewedById  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model DutyShift {
  id                String    @id @default(cuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  clockInAt         DateTime  @default(now())
  clockInSignature  String
  clockOutAt        DateTime?
  clockOutSignature String?
  supervisorNote    String?
  approvedAt        DateTime?
  approvedById      String?
  activitySeconds   Int       @default(0)
  createdAt         DateTime  @default(now())
}

model Strike {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  reason       String
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
  resolvedById String?
}